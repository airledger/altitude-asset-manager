{
  "name": "air-ledger-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Air Ledger iPhone and Android apps (Capacitor wrapper around the web app in the repo root)",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#0F2238' --splashBackgroundColor '#0F2238' --iconBackgroundColorDark '#0F2238' --splashBackgroundColorDark '#0F2238'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/supabase-js": "2.45.4",
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.6.0"
  }
}
