{
  "name": "@airledger/mobile",
  "private": true,
  "description": "Air Ledger iPhone and Android apps: Capacitor around the web app in apps/web",
  "scripts": {
    "build:beta": "npm run build:beta -w @airledger/web && cap sync",
    "build:live": "npm run build -w @airledger/web && cap sync",
    "ios": "npm run build:beta && cap open ios",
    "android": "npm run build:beta && cap open android",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#0F2238' --splashBackgroundColor '#0F2238' --iconBackgroundColorDark '#0F2238' --splashBackgroundColorDark '#0F2238'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.6.0"
  }
}
